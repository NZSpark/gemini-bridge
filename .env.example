[TEMPLATE]
# GeminiBridge 配置模板。复制为 .env 后按需修改；真实环境变量优先于本文件。

# ---- 服务监听 ----
HOST=127.0.0.1
PORT=8001
# 入口 URL：每桶新开对话的落点（改这里会真的生效）
WEBSITE=https://gemini.google.com/app

# ---- 路径 ----
USER_DATA_DIR=./user_data
OUTPUT_DIR=./output
SESSION_FILE=./user_data/.gemini_state

# ---- 运行模式 / 调试 ----
HEADLESS=false
GEMINI_DEBUG=false
# /session/reset 的可选令牌；留空 = 不校验
RESET_TOKEN=
# /v1/chat/completions 流式 keep-alive 间隔（秒），0 = 关闭
CHAT_KEEPALIVE_S=10.0

# ---- 回复结束检测 / 超时 ----
GEMINI_TIMEOUT=180
POLL_INTERVAL_S=1.5
STABLE_POLLS=2
LEN_STABLE_POLLS=4
STALL_POLLS=20
# 「会话到顶」提示语匹配规则（|| 分隔多条正则，大小写不敏感）
CAP_NOTICE_PATTERNS=达到对话长度上限||对话长度上限||已达到长度限制||达到长度限制||开启新对话||开始新的聊天||context length limit||start a new chat

# ---- 重试 ----
GEMINI_RETRIES=2
RETRY_BACKOFF_S=1.0

# ---- 会话生命周期 ----
GEMINI_NEW_SESSION=false
SESSION_KEY_HEADER=X-Gemini-Session
SESSION_SCOPING=true
SESSION_SCOPING_BY_UA=true
SESSION_KEY_MAX_LEN=64
MAX_SESSION_BUCKETS=8
MAX_SESSION_STATE_CACHE=64
BUCKET_IDLE_TTL_S=900
PARALLEL_BUCKETS=false
BUCKET_LOCK_TIMEOUT_S=0
READY_TIMEOUT_MS=15000
SEED_MAX_CHARS=12000
SEED_SYSTEM_MAX_CHARS=2000
SESSION_MAX_TURNS=60
SESSION_MAX_TOKENS=60000
CAP_CHECK_EVERY=4

# ---- 代码落盘 ----
SAVE_FILES=false
OUTPUT_MAX_FILES=0
OUTPUT_MAX_AGE_DAYS=0
# 后台周期清理间隔（秒）；启动时一定清一次。0 = 只保留启动清理
OUTPUT_PRUNE_INTERVAL_S=3600

# ---- Responses API（Codex CLI）----
ENABLE_RESPONSES_API=true
RESPONSES_KEEPALIVE_S=10.0
RESPONSES_TOOL_BUFFER=true

# ---- 任务快照 ----
TASK_SNAPSHOT_ENABLED=true
TASK_FILE_DIR=./user_data/.gemini_tasks
TASK_NAMESPACE=
TASK_GOAL_MAX_CHARS=2000
TASK_KEEP_MESSAGES=8
TASK_RECENT_ITEM_MAX_CHARS=500

# ---- DOM 选择器 ----
RESPONSE_SELECTORS=message-content, .model-response-text, .markdown, div[class*="response"]
INPUT_SELECTORS=rich-textarea [contenteditable="true"]||div[contenteditable="true"]||textarea[placeholder*="Ask"]||textarea
READY_SELECTOR=rich-textarea, [contenteditable="true"], textarea
SEND_BUTTON_SELECTORS=button[aria-label*="Send"]||button[aria-label*="send"]||button[aria-label*="发送"]||button[data-test-id*="send"]||button[type="submit"]
NEW_CHAT_SELECTOR=button[aria-label*="New chat"]||button[aria-label*="new chat"]||button[aria-label*="新对话"]||button[aria-label*="新聊天"]
CODE_BLOCK_SELECTOR=pre
CODE_TAG_SELECTOR=code

# ---- 提示词预算 ----
# 单条 tool 结果注入 prompt 的最大字符数（0 不限）
TOOL_RESULT_MAX_CHARS=20000
# 单次 fill() 入参硬上限（0 不限）
PROMPT_MAX_CHARS=100000

# ---- 内置工具：edit_markdown ----
# 允许桥接层本地执行 edit_markdown（Markdown 锚点编辑）。
# 关闭时 edit_markdown 仍可被解析，但由客户端自行执行。
EDIT_MARKDOWN_LOCAL=true
# 客户端未声明任何工具时是否仍注入 edit_markdown。默认 false：
# 自动注入会给每个请求多付约 970 tokens 的脚手架，并可能产生客户端没声明的 tool_calls。
EDIT_MARKDOWN_ALWAYS_REGISTER=false
# edit_markdown 落盘前的备份目录。
EDIT_MARKDOWN_BACKUP_DIR=output/backups
