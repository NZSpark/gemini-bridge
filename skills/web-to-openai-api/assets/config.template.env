# Web → OpenAI API 桥接：参数模板（由 GeminiBridge 实战蒸馏）
# 复制为 .env 使用。每个参数都写明「为什么存在」；站点改版优先改本文件而不是代码。
# 命名约定：多候选选择器用 || 分隔；布尔用 1/true/yes/on。
# 把 GEMINI_/SITE 前缀按你的项目约定统一替换（GeminiBridge 用 GEMINI_ 前缀防多桥环境变量互撞）。

# ==================== 服务监听 ====================
# 只监听 127.0.0.1：转发的是你的登录会话，暴露到网络等于把账号交出去。
HOST=127.0.0.1
PORT=8001
# 入口 URL：每桶新开对话的落点。必须真的被读取——「死配置」（.env 有键、代码从不读）
# 是 GeminiBridge 复审抓到的 P1 级排障陷阱。
WEBSITE=https://example.com/app

# ==================== 路径 ====================
USER_DATA_DIR=./user_data              # Chromium 持久化 profile（登录态，勿提交 git、勿云同步）
SESSION_FILE=./user_data/.bridge_state # 会话状态文件（轮数/预算/到顶/待播种；原子写）
OUTPUT_DIR=./output                    # 提取到的代码 / 回复落盘目录
DEBUG=false                            # 1 = 每轮轮询打印节点数/长度/生成状态/命中；
                                       # 并开放 /debug/dom（只报结构，不回显正文）

# ==================== 回复结束检测 / 超时 ====================
# 单轮总超时（秒）：结束判定失灵的兜底；必须小于客户端 HTTP 超时（建议客户端 240 <-> 这里 180）。
TIMEOUT=180
POLL_INTERVAL_S=1.5
STABLE_POLLS=2                         # 内容指纹相同连续这么多次 → 收尾（指位数可 JSON）
LEN_STABLE_POLLS=4                     # 仅长度不再增长时的收尾（更保守）
STALL_POLLS=20                         # 连续 N 轮既无新正文也无「生成中」→ 提前失败（快速失败）
# 「会话到顶」提示语（|| 分隔多条正则，大小写不敏感）。必须抄页面原文，不能猜。
CAP_NOTICE_PATTERNS=达到对话长度上限||对话长度上限||已达到长度限制||达到长度限制||开启新对话||context length limit||start a new chat
CAP_CHECK_EVERY=4                      # 每 N 轮检查一次到顶提示
# 生成信号消失、但连续 N 轮仍无【新正文】→ 判失败并轮转（防旧内容/回显被当回复）。
# 这是「提示词反复叠加死循环」的守门员，别设为 0。
NO_NEW_TEXT_END_POLLS=2

# ==================== 重试 ====================
RETRIES=2                              # 上游最大【尝试次数】（不是“额外重试次数”：2 = 最多发 2 次）
RETRY_BACKOFF_S=1.0                    # 退避基数（第 n 次等待 RETRY_BACKOFF_S * n）

# ==================== 输入框写入 / 提交 ====================
# 超长 prompt 会一次性 fill 把网页主线程排成长任务 = 输入框卡死；分块写入解决。
FILL_TIMEOUT_MS=10000                  # 单次插入 / 点击 / 读取超时（Playwright 默认 30s 太长）
FILL_RETRIES=3                         # 写入最大尝试次数（每次重新定位输入框）
FILL_CHUNK_CHARS=4000                  # 分块写入每块字符数（慢机器可降到 2000）
PROMPT_MAX_CHARS=100000                # 主动预算（不是物理上限；实测 100K 可正常收发）；
                                       # 超出时截图/截短并记 WARNING；0 = 不限
SUBMIT_VERIFY_MS=3000                  # 提交后等待「输入框已清空 / 页面开始生成」的最长时间；
                                       # 提交阶梯（真实键盘 Enter → 原生 click → 合成 Enter）每级后验证

# ==================== 提示词预算（三层口径）====================
TOOL_RESULT_MAX_CHARS=50000            # 单条工具结果注入 prompt 的上限：超出只留开头 + 标注「已截断 N 字符」
                                       # （策略：不整块丢，只截短并说明）；0 = 不限
SEED_MAX_CHARS=12000                   # 播种（历史重放）字符预算；超出从最旧的开始丢
SEED_SYSTEM_MAX_CHARS=2000             # 播种时单条 system 消息上限（harness 系统块会被截断）
TASK_GOAL_MAX_CHARS=2000               # 任务快照里「任务目标」保留上限（防被播种截断丢任务）
TASK_KEEP_MESSAGES=8                   # 快照滚动保留的最近消息数
TASK_RECENT_ITEM_MAX_CHARS=500         # 快照单条 recent 文本上限（防系统块灌满 prompt）

# ==================== 会话生命周期 ====================
# 「新开对话」必须与「历史播种」成对出现；轮转由会话健康度/体积决定，与进程重启无关。
NEW_SESSION_ON_START=false             # true = 启动即新开对话（首轮播种）
SESSION_MAX_TURNS=60                   # 轮数到顶 → 下一轮轮转（0 禁用）
SESSION_MAX_TOKENS=60000               # 估算 token 到顶 → 轮转（0 禁用）。
                                       # 注意：GeminiBridge 的 1000000 是按模型容量测的，
                                       # 不是按网页版响应性；换站点要重新标定。
SESSION_KEY_HEADER=X-Gemini-Session    # 分桶键请求头（换站点改名字）
SESSION_SCOPING=true                   # false = 所有请求共用默认会话
SESSION_SCOPING_BY_UA=true             # 无显式键时按 User-Agent 分桶（SDK 会落 ua:<sdk> 桶）
SESSION_KEY_MAX_LEN=64                 # 分桶键长度上限
MAX_SESSION_BUCKETS=8                  # 会话桶上限（LRU 关最久未用页，状态保留）
MAX_SESSION_STATE_CACHE=64             # 内存会话状态缓存上限（0 不限）
BUCKET_IDLE_TTL_S=900                  # 空闲页面回收秒数（0 关闭）
PARALLEL_BUCKETS=false                 # true = 各桶并行页面（真并发会同时驱动多个网页会话，风控风险）
BUCKET_LOCK_TIMEOUT_S=0                # 同桶排队超时；>0 超时返回 503 upstream_busy；0 = 一直等
TASK_SNAPSHOT_ENABLED=true             # 轮转时注入任务目标 + 最近进展
TASK_FILE_DIR=./user_data/.tasks
TASK_NAMESPACE=                        # 留空 = 由实现包目录名派生（多桥共用目录时防互撞）

# ==================== 代码落盘 / 保留策略 ====================
SAVE_FILES=false                       # 是否落盘回复代码块；请求字段仅在显式传入时覆盖
OUTPUT_MAX_FILES=0                     # 保留文件数上限（0 不限）
OUTPUT_MAX_AGE_DAYS=0                  # 保留天数上限（0 不限）
OUTPUT_PRUNE_INTERVAL_S=3600           # 周期清理间隔（秒）；启动时一定清一次；0 = 只保留启动清理

# ==================== Responses API（Codex CLI，可选）====================
ENABLE_RESPONSES_API=true              # false = /v1/responses 返回 404（不影响 chat）
RESPONSES_KEEPALIVE_S=10               # 流式 keep-alive 间隔（0 关闭；防客户端 idle 断连）
RESPONSES_TOOL_BUFFER=true             # 工具模式先缓冲整段回复再解析 tool_calls

# ==================== 流式 / 鉴权 ====================
CHAT_KEEPALIVE_S=10.0                  # chat 流式 keep-alive 间隔（0 关闭）
BRIDGE_TOKEN=                          # 非空则生成端点需 Bearer（默认关闭，向后兼容）；
                                       # 探活与模型发现保持开放
RESET_TOKEN=                           # 非空则 /session/reset 需带 X-Reset-Token

# ==================== 内置工具（可选，默认关）====================
# 教训：客户端没声明任何工具时不得注入内置工具——曾每请求白付 ~970 tokens 脚手架，
# 还会产生客户端从未声明的 tool_calls。留 ALWAYS_REGISTER 作显式逃生口。
EDIT_MARKDOWN_LOCAL=false              # 允许桥接层本地执行（默认只注册 schema，由客户端执行）
EDIT_MARKDOWN_ALWAYS_REGISTER=false    # 客户端未声明工具时是否仍注入（默认 false）
EDIT_MARKDOWN_BACKUP_DIR=output/backups
EDIT_MARKDOWN_ROOT=                    # 留空 = 项目根；路径 resolve 后必须落在根内（沙箱，无关闭选项）

# ==================== DOM 选择器（站点改版只改这里）====================
# 先用 scripts/recon.py 生成候选，再按置信度排成 || 回退链；语义属性/aria-label 优先，哈希类名兜底。
INPUT_SELECTORS=rich-textarea [contenteditable="true"]||div[contenteditable="true"]||textarea[placeholder*="Ask"]||textarea
SEND_BUTTON_SELECTORS=button[aria-label*="Send"]||button[aria-label*="send"]||button[aria-label*="发送"]||button[type="submit"]
RESPONSE_SELECTORS=message-content, .model-response-text, .markdown, div[class*="response"]
READY_SELECTOR=rich-textarea, [contenteditable="true"], textarea
NEW_CHAT_SELECTOR=button[aria-label*="New chat"]||button[aria-label*="新对话"]||a[aria-label*="New chat"]
CODE_BLOCK_SELECTOR=pre
CODE_TAG_SELECTOR=code
